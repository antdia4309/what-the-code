@page "/"
@implements IDisposable
@using WhatTheCode.Models
@using WhatTheCode.Services
@inject ProgressStore Progress
@inject IJSRuntime JS

<PageTitle>What the CODE? · Level @_level.Number</PageTitle>

<div class="play">
    <header class="topbar">
        <h1 class="logo">What the <span>CODE?</span></h1>

        <nav class="level-path" aria-label="Levels">
            <ol>
                @foreach (var level in LevelCatalog.All)
                {
                    var l = level;
                    var unlocked = Progress.IsUnlocked(l.Number);
                    var stars = Progress.StarsFor(l.Number);
                    <li class="@(l.Number == PartTwoStart ? "part-start" : "")">
                        <button type="button"
                                class="level-stop @(l == _level ? "is-current" : "") @(stars > 0 ? "is-solved" : "")"
                                disabled="@(!unlocked || _running)"
                                aria-current="@(l == _level ? "step" : null)"
                                aria-label="@LevelLabel(l, unlocked, stars)"
                                @onclick="() => SelectLevel(l)">
                            <span class="level-num">@(unlocked ? l.Number.ToString() : "🔒")</span>
                            <span class="level-stars" aria-hidden="true">@StarText(stars)</span>
                        </button>
                    </li>
                }
            </ol>
        </nav>
    </header>

    <main class="stage">
        <section class="intro" aria-labelledby="level-title">
            <h2 id="level-title" class="level-title">
                <span class="level-tag">Level @_level.Number</span>
                @_level.Title
            </h2>

            @if (_level.NewIdea is not null)
            {
                <p class="new-idea"><strong>New idea.</strong> @_level.NewIdea</p>
            }
        </section>

        <section class="board-panel" aria-label="Board">
            @if (_sessions.Count > 1)
            {
                <div class="board-tabs" role="tablist" aria-label="Boards">
                    <span class="board-tabs-note">One program has to solve all @_sessions.Count boards.</span>
                    <span class="board-tabs-note-short" aria-hidden="true">Solve all:</span>
                    @for (int i = 0; i < _sessions.Count; i++)
                    {
                        var index = i;
                        <button type="button" role="tab"
                                class="board-tab board-@_boardStates[index].ToString().ToLowerInvariant()"
                                aria-selected="@(index == _shown ? "true" : "false")"
                                disabled="@_running"
                                @onclick="() => _shown = index">
                            Board @(index + 1)
                            <span aria-hidden="true">@BoardMark(_boardStates[index])</span>
                        </button>
                    }
                </div>
            }

            @* Tapping the board doesn't move the bot, so explain what does. *@
            <div class="board-wrap" @onclick="NudgeAsync">
                <GameGrid Session="ShownSession" Crashed="_crashedBoard == _shown" Celebrating="_status.Kind == StatusKind.Success"
                          Ghost="@(_answerRevealed ? _answerPaths[_shown] : null)" />
            </div>

            @if (_nudge)
            {
                <p class="nudge" role="status">The bot only follows your program. Tap a block to add it, then press Run.</p>
            }
            else
            {
            <div class="status status-@_status.Kind.ToString().ToLowerInvariant() @(_paused ? "is-paused" : "")" role="status" aria-live="polite">
                @if (_paused)
                {
                    <span class="paused-tag">Paused</span>
                }
                @if (_status.Kind == StatusKind.Success)
                {
                    <p class="stars-earned" aria-label="@_earnedStars of 3 stars">@StarText(_earnedStars, showEmpty: true)</p>
                }
                <p>@_status.Message</p>
                @if (_status.Kind == StatusKind.Success && NextLevel is not null)
                {
                    <button type="button" class="btn btn-next" @onclick="() => SelectLevel(NextLevel)">Next level</button>
                }
                else if (_status.Kind == StatusKind.Success)
                {
                    <p class="all-done">That's every level so far. Try earning three stars on each one.</p>
                }
            </div>
            }
        </section>

        <section class="help-panel" aria-label="Tips and hints">
            <p class="tip">@_level.Tip</p>

            <div class="help" aria-live="polite">
                @for (int i = 0; i < _hintsShown; i++)
                {
                    <p class="hint"><strong>Hint @(i + 1).</strong> @_level.Hints[i]</p>
                }

                @if (_answerRevealed)
                {
                    <div class="help-box answer">
                        <p>
                            The dotted rings on the board show the route the answer takes@(_sessions.Count > 1 ? ". Switch boards to see each one." : ".")
                        </p>
                        <button type="button" class="btn btn-quiet" disabled="@_running" @onclick="LoadAnswer">Put the answer in my program</button>
                    </div>
                }
                else if (_confirmingAnswer)
                {
                    <div class="help-box confirm">
                        <p>If you see the answer, solving this level earns 1 star this time. You can always replay it on your own for 3.</p>
                        <div class="help-actions">
                            <button type="button" class="btn btn-reveal" @onclick="RevealAnswer">Show the answer</button>
                            <button type="button" class="btn btn-quiet" @onclick="() => _confirmingAnswer = false">Keep trying</button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="help-actions">
                        @if (_hintsShown < _level.Hints.Count)
                        {
                            <button type="button" class="btn btn-quiet btn-small" @onclick="() => _hintsShown++">
                                @(_hintsShown == 0 ? "Stuck? Show a hint" : "Show another hint")
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-quiet btn-small" @onclick="() => _confirmingAnswer = true">Show the answer</button>
                        }
                    </div>
                }
            </div>
        </section>

        <section class="workshop" aria-label="Build your program">
            @* On phones the dock is pinned to the bottom of the screen, within thumb reach. *@
            <div class="dock">
                <div class="palette">
                    <h3 class="palette-title">Blocks</h3>
                    <div class="palette-blocks @(_nudge || ShowFirstTimeHint ? "is-nudged" : "")">
                        @foreach (var kind in _level.Blocks)
                        {
                            var k = kind;
                            <button type="button" class="palette-block palette-@PaletteClass(k)"
                                    disabled="@(_running || !CanAdd(k))"
                                    @onclick="() => AddBlock(k)">
                                + @Instruction.LabelFor(k)
                            </button>
                        }
                    </div>
                </div>

                <div class="run-controls">
                    @if (!_running)
                    {
                        <button type="button" class="btn btn-run" disabled="@(_program.Count == 0)" @onclick="() => RunAsync()">▶ Run</button>
                        <button type="button" class="btn btn-quiet" disabled="@(_program.Count == 0)" @onclick="StepAsync"
                                title="Run one block at a time">Step</button>
                        <button type="button" class="btn btn-quiet" @onclick="ResetBoards">Reset<span class="wide-only"> bot</span></button>
                        <button type="button" class="btn btn-quiet" disabled="@(_program.Count == 0)" @onclick="ClearProgram">Clear</button>
                    }
                    else
                    {
                        @if (_paused)
                        {
                            <button type="button" class="btn btn-run" @onclick="Resume">▶ Resume</button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-pause" @onclick="Pause">❚❚ Pause</button>
                        }
                        <button type="button" class="btn btn-quiet" @onclick="StepAsync" title="Run the next block, then pause">Step</button>
                        <button type="button" class="btn btn-stop" @onclick="Stop">■ Stop</button>
                    }
                    <button type="button" class="btn btn-quiet btn-speed" @onclick="CycleSpeed"
                            aria-label="Speed: @SpeedName. Tap to change." title="Change speed">
                        <span aria-hidden="true">@SpeedIcon</span><span class="wide-only"> @SpeedName</span>
                    </button>
                </div>
            </div>

            <div class="program">
                <div class="program-head">
                    <h3>Your program</h3>
                    <span class="block-count">@BlocksUsed @(BlocksUsed == 1 ? "block" : "blocks") · par @_level.Par</span>
                </div>

                @if (_target is not null && !_running)
                {
                    var owner = FindOwner(_target, _program);
                    <p class="target-note">
                        Adding inside @TargetName(owner).
                        <button type="button" class="link-btn" disabled="@_running" @onclick="StepOut">Add after that block</button>
                        @if (owner?.Parent != _program)
                        {
                            <span aria-hidden="true"> · </span>
                            <button type="button" class="link-btn" disabled="@_running" @onclick="() => SelectTarget(null)">Add to the end</button>
                        }
                    </p>
                }

                <div class="program-list @(_target is null && !_running ? "is-target" : "")"
                     @onclick="() => SelectTarget(null)">
                    @if (_program.Count == 0)
                    {
                        <p class="program-empty">Tap a block to add it to your program.</p>
                    }
                    else
                    {
                        <BlockList Items="_program" Target="_target" ActiveId="_activeId" FailedId="_failedId"
                                   Passes="_passes" Check="_check"
                                   Disabled="_running"
                                   OnRemove="RemoveBlock" OnSelectTarget="SelectTarget"
                                   OnCountChange="ChangeCount" OnCycleCondition="CycleCondition" />
                    }
                </div>
            </div>

            <div class="bridge">
                <h3>Your program in C#</h3>
                <pre class="code" aria-label="Generated C# code"><code>@foreach (var line in CodeGenerator.Generate(_program))
{<span class="code-line @LineClass(line)">@line.Text
</span>}</code></pre>
            </div>
        </section>
    </main>
</div>

@code {
    private enum StatusKind { Idle, Running, Success, Fail }
    private enum BoardState { Untried, Passed, Failed }
    private record Status(StatusKind Kind, string Message);

    private enum Speed { Slow, Normal, Fast }

    private const int BetweenBoardsMs = 650;
    private const int MaxNesting = 3;
    private const int PartTwoStart = 7;

    private const string ReadyEmpty = "Build a program, then press Run.";
    private const string ReadyToRun = "Ready. Press Run to try it.";

    private Level _level = LevelCatalog.All[0];
    private List<GameSession> _sessions = new();
    private BoardState[] _boardStates = Array.Empty<BoardState>();
    private int _shown;

    private List<Instruction> _program = new();
    private List<Instruction>? _target; // null means "end of the main program"

    private bool _running;
    private int? _crashedBoard;
    private Guid? _activeId;
    private Guid? _failedId;
    private int _earnedStars;

    // Help: hints are free; seeing the answer caps this solve at one star.
    private int _hintsShown;
    private bool _confirmingAnswer;
    private bool _answerRevealed;
    private List<HashSet<Cell>> _answerPaths = new();

    // Phone helpers
    private bool _nudge;
    private CancellationTokenSource? _nudgeCts;
    private bool _scrollLevelStrip = true;
    private Guid? _revealBlockId;
    private Guid? _lastFollowed;

    /// <summary>On the very first level, gently point at the blocks until something is added.</summary>
    private bool ShowFirstTimeHint => _level.Number == 1 && _program.Count == 0 && !_running && !Progress.IsSolved(1);
    private CancellationTokenSource? _cts;

    // Debugging: pause, step, speed, and what the program just decided.
    private Speed _speed = Speed.Normal;
    private bool _paused;
    private TaskCompletionSource? _gate;
    private string? _decision;
    private string? _lastAction;
    private (Guid Id, bool Answer)? _check;
    private IReadOnlyDictionary<Guid, int>? _passes;

    private int StepDelayMs => _speed switch { Speed.Slow => 800, Speed.Fast => 140, _ => 380 };
    private int CheckDelayMs => _speed switch { Speed.Slow => 650, Speed.Fast => 90, _ => 260 };
    private string SpeedName => _speed switch { Speed.Slow => "Slow", Speed.Fast => "Fast", _ => "Normal" };
    private string SpeedIcon => _speed switch { Speed.Slow => "🐢", Speed.Fast => "🐇", _ => "🚶" };
    private Status _status = new(StatusKind.Idle, ReadyEmpty);

    private GameSession ShownSession => _sessions[_shown];
    private int BlocksUsed => Instruction.CountBlocks(_program);
    private Level? NextLevel => LevelCatalog.All.FirstOrDefault(l => l.Number == _level.Number + 1);

    protected override void OnInitialized() => LoadLevel(LevelCatalog.All[0]);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Progress.LoadAsync();
            var resumeAt = LevelCatalog.All.FirstOrDefault(l => !Progress.IsSolved(l.Number)) ?? LevelCatalog.All[^1];
            LoadLevel(resumeAt);
            StateHasChanged();
            return;
        }

        try
        {
            if (_scrollLevelStrip)
            {
                _scrollLevelStrip = false;
                await JS.InvokeVoidAsync("wtc.showCurrentLevel");
            }

            if (_revealBlockId is { } id)
            {
                _revealBlockId = null;
                await JS.InvokeVoidAsync("wtc.revealBlock", id.ToString(), 150);
            }

            // While stepping (or after a crash), keep the highlighted block in view.
            var follow = _paused ? _activeId : _failedId;
            if (follow is { } focus && focus != _lastFollowed)
            {
                _lastFollowed = focus;
                await JS.InvokeVoidAsync("wtc.revealBlock", focus.ToString(), 56);
            }
        }
        catch (JSException)
        {
            // Scrolling helpers are cosmetic; never let them break the game.
        }
    }

    /// <summary>Someone tapped the board expecting it to move the bot. Point them at the blocks instead.</summary>
    private async Task NudgeAsync()
    {
        if (_running) return;

        _nudgeCts?.Cancel();
        _nudgeCts = new CancellationTokenSource();
        var token = _nudgeCts.Token;
        _nudge = true;

        try
        {
            await Task.Delay(4000, token);
            _nudge = false;
        }
        catch (OperationCanceledException)
        {
            // A newer tap restarted the timer.
        }
    }

    // ---------- Levels ----------

    private void SelectLevel(Level level)
    {
        if (_running || !Progress.IsUnlocked(level.Number)) return;
        LoadLevel(level);
    }

    private void LoadLevel(Level level)
    {
        _level = level;
        _sessions = level.Boards.Select(b => new GameSession(b)).ToList();
        _boardStates = new BoardState[_sessions.Count];
        _shown = 0;
        _program = new();
        _target = null;
        _hintsShown = 0;
        _confirmingAnswer = false;
        _answerRevealed = false;
        _answerPaths = new();
        _nudge = false;
        _scrollLevelStrip = true;
        ClearRunState();
        _status = new(StatusKind.Idle, ReadyEmpty);
    }

    // ---------- Help ----------

    private void RevealAnswer()
    {
        _answerPaths = _level.Boards.Select(b => SolutionPath.Trace(b, _level.Solution())).ToList();
        _answerRevealed = true;
        _confirmingAnswer = false;
    }

    private void LoadAnswer()
    {
        if (_running) return;
        _program = _level.Solution();
        _target = null;
        OnProgramEdited();
    }

    // ---------- Editing ----------

    private bool CanAdd(BlockKind kind) =>
        !new Instruction(kind).IsContainer || Depth(_target) < MaxNesting;

    private void AddBlock(BlockKind kind)
    {
        if (_running || !CanAdd(kind)) return;

        var block = new Instruction(kind);
        (_target ?? _program).Add(block);

        if (block.IsContainer) _target = block.Body; // next blocks go inside the new block
        _nudge = false;
        _revealBlockId = block.Id;
        OnProgramEdited();
    }

    private void RemoveBlock(Instruction block)
    {
        if (_running) return;

        if (_target is not null && block.ChildLists.Any(l => l == _target || ContainsList(l, _target)))
            _target = null;

        RemoveFrom(_program, block);
        OnProgramEdited();
    }

    private void ChangeCount((Instruction Block, int Delta) change)
    {
        if (_running) return;
        change.Block.ChangeCount(change.Delta);
        OnProgramEdited();
    }

    private void CycleCondition(Instruction block)
    {
        if (_running) return;
        block.CycleCondition();
        OnProgramEdited();
    }

    private void SelectTarget(List<Instruction>? list)
    {
        if (_running) return;
        _target = list;
    }

    /// <summary>Move the insertion point to just after the block that owns the current target.</summary>
    private void StepOut()
    {
        if (_running || _target is null) return;
        var parent = FindOwner(_target, _program)?.Parent;
        _target = parent == _program ? null : parent;
    }

    private void ClearProgram()
    {
        _program.Clear();
        _target = null;
        OnProgramEdited();
    }

    private void OnProgramEdited()
    {
        ResetBoards();
    }

    // ---------- Running ----------

    private async Task RunAsync(bool startPaused = false)
    {
        if (_running || _program.Count == 0) return;

        ResetBoards();
        _running = true;
        _paused = startPaused;
        _cts = new CancellationTokenSource();
        var token = _cts.Token;
        ShowRunStatus();

        try
        {
            for (int board = 0; board < _sessions.Count; board++)
            {
                _shown = board;
                var session = _sessions[board];
                var runner = new ProgramRunner(session);
                var prefix = _sessions.Count > 1 ? $"Board {board + 1}: " : "";
                _passes = runner.Passes;

                StateHasChanged();
                if (board == 0) await Task.Delay(150, token);
                else await WaitAsync(BetweenBoardsMs, token);

                foreach (var step in runner.Run(_program))
                {
                    _activeId = step.Source.Id;

                    if (step.IsAction)
                    {
                        _check = null;
                        _decision = null;
                        _lastAction = step.Action switch
                        {
                            BlockKind.TurnLeft  => "Turned left.",
                            BlockKind.TurnRight => "Turned right.",
                            _                   => "Moved forward."
                        };
                        var outcome = session.Apply(step.Action);

                        if (outcome is StepOutcome.HitWall or StepOutcome.HitEdge)
                        {
                            Fail(board, step.Source.Id, prefix + (outcome == StepOutcome.HitWall
                                ? "Bonk! The highlighted block drove the bot into a wall."
                                : "Whoa, the highlighted block tried to drive off the edge of the board."));
                            return;
                        }
                    }
                    else
                    {
                        _check = (step.Source.Id, step.Answer);
                        _decision = Explain(step);
                        _lastAction = null;
                    }

                    ShowRunStatus();
                    StateHasChanged();
                    await WaitAsync(step.IsAction ? StepDelayMs : CheckDelayMs, token);
                }

                _activeId = null;
                _check = null;
                _decision = null;

                if (runner.RanOutOfSteps)
                {
                    Fail(board, null, prefix + "The bot went around in circles and never got there. Check that your loop can actually reach the flag.");
                    return;
                }

                if (!session.OnFlag)
                {
                    Fail(board, null, prefix + "The program finished, but the bot isn't on the flag. Add more blocks or check your turns.");
                    return;
                }

                _boardStates[board] = BoardState.Passed;
            }

            await CompleteLevelAsync();
        }
        catch (OperationCanceledException)
        {
            _activeId = null;
            _status = new(StatusKind.Idle, "Stopped. Change your program or press Run again.");
        }
        finally
        {
            _running = false;
            _paused = false;
            _gate = null;
            _check = null;
            _passes = null;
            _decision = null;
            _lastAction = null;
            _cts?.Dispose();
            _cts = null;
            StateHasChanged();
        }
    }

    /// <summary>Waits between steps. While paused, waits until Step or Resume instead.</summary>
    private async Task WaitAsync(int ms, CancellationToken token)
    {
        if (!_paused)
        {
            await Task.Delay(ms, token);
            if (!_paused) return; // Pause was pressed mid-delay: fall through and hold here
        }

        _gate = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
        ShowRunStatus();
        StateHasChanged();

        using (token.Register(() => _gate?.TrySetCanceled()))
            await _gate.Task;

        _gate = null;
    }

    private void Pause()
    {
        if (!_running || _paused) return;
        _paused = true;
        ShowRunStatus();
    }

    private void Resume()
    {
        if (!_running) return;
        _paused = false;
        ShowRunStatus();
        _gate?.TrySetResult();
    }

    /// <summary>Runs the next block, then pauses. Starts a paused run if nothing is running.</summary>
    private async Task StepAsync()
    {
        if (!_running)
        {
            await RunAsync(startPaused: true);
            return;
        }

        if (!_paused)
        {
            Pause();
            return;
        }

        _gate?.TrySetResult();
    }

    private void CycleSpeed() =>
        _speed = _speed switch { Speed.Slow => Speed.Normal, Speed.Normal => Speed.Fast, _ => Speed.Slow };

    private void ShowRunStatus()
    {
        var message = _decision
            ?? (_paused
                ? (_lastAction ?? "Ready.") + " Step runs the next block. Resume carries on from here."
                : "Running…");
        _status = new(StatusKind.Running, message);
    }

    /// <summary>Says out loud what an If or Repeat-until just decided, and what happens next.</summary>
    private static string Explain(ProgramStep step)
    {
        var block = step.Source;

        if (block.Kind == BlockKind.RepeatUntilFlag)
            return step.Answer
                ? "At the flag? Yes, so the loop stops."
                : "At the flag? Not yet, so the loop goes again.";

        var question = char.ToUpper(block.ConditionLabel[0]) + block.ConditionLabel[1..] + "?";

        if (step.Answer)
            return block.Body.Count > 0
                ? $"{question} Yes, so the top part runs."
                : $"{question} Yes, but the top part is empty, so nothing happens.";

        return block.ElseBody.Count > 0
            ? $"{question} No, so the Otherwise part runs."
            : $"{question} No, and there's no Otherwise part, so it skips ahead.";
    }

    private void Fail(int board, Guid? blockId, string message)
    {
        _paused = false;
        _boardStates[board] = BoardState.Failed;
        _activeId = null;
        _failedId = blockId;
        if (blockId is not null) _crashedBoard = board;
        _status = new(StatusKind.Fail, message);
    }

    private async Task CompleteLevelAsync()
    {
        var used = BlocksUsed;
        _earnedStars = _answerRevealed ? 1 : _level.StarsFor(used);
        await Progress.RecordAsync(_level.Number, _earnedStars);

        var where = _sessions.Count > 1 ? $"on all {_sessions.Count} boards " : "";
        var message = _answerRevealed
            ? $"Flag reached {where}with the answer's help, so this one's worth 1 star. Replay it on your own for 3."
            : used <= _level.Par
            ? $"Flag reached {where}with {used} {(used == 1 ? "block" : "blocks")}. That's par. Nicely done."
            : $"Flag reached {where}with {used} blocks. Par is {_level.Par}. Can you do it with fewer?";
        _status = new(StatusKind.Success, message);
    }

    private void Stop() => _cts?.Cancel();

    private void ResetBoards()
    {
        foreach (var s in _sessions) s.Reset();
        _boardStates = new BoardState[_sessions.Count];
        ClearRunState();
        _status = new(StatusKind.Idle, _program.Count == 0 ? ReadyEmpty : ReadyToRun);
    }

    private void ClearRunState()
    {
        _crashedBoard = null;
        _activeId = null;
        _failedId = null;
        _earnedStars = 0;
    }

    public void Dispose()
    {
        _gate?.TrySetCanceled();
        _cts?.Cancel();
        _cts?.Dispose();
        _nudgeCts?.Cancel();
        _nudgeCts?.Dispose();
    }

    // ---------- Program tree helpers ----------

    /// <summary>The block that owns a child list, and the list that block sits in.</summary>
    private record Owner(Instruction Block, List<Instruction> Parent, bool IsElse);

    private static Owner? FindOwner(List<Instruction> target, List<Instruction> list)
    {
        foreach (var block in list)
        {
            if (block.IsContainer && block.Body == target) return new Owner(block, list, false);
            if (block.Kind == BlockKind.If && block.ElseBody == target) return new Owner(block, list, true);

            foreach (var child in block.ChildLists)
            {
                var found = FindOwner(target, child);
                if (found is not null) return found;
            }
        }
        return null;
    }

    /// <summary>How many container blocks enclose a list (the main program is 0).</summary>
    private int Depth(List<Instruction>? list)
    {
        int depth = 0;
        while (list is not null && list != _program)
        {
            var owner = FindOwner(list, _program);
            if (owner is null) break;
            depth++;
            list = owner.Parent;
        }
        return depth;
    }

    private static bool ContainsList(List<Instruction> haystack, List<Instruction> needle) =>
        haystack.Any(b => b.ChildLists.Any(l => l == needle || ContainsList(l, needle)));

    private static bool RemoveFrom(List<Instruction> list, Instruction target) =>
        list.Remove(target) || list.Any(b => b.ChildLists.Any(l => RemoveFrom(l, target)));

    // ---------- Display helpers ----------

    private static string TargetName(Owner? owner) => owner switch
    {
        null => "a block",
        { Block.Kind: BlockKind.If, IsElse: true } => "the If's Otherwise part",
        { Block.Kind: BlockKind.If } => "the If's yes part",
        _ => $"the {owner.Block.Label}"
    };

    private string LineClass(CodeLine line)
    {
        if (line.SourceId is null || !line.IsStatement) return "";
        if (line.SourceId == _activeId) return "is-active";
        if (line.SourceId == _failedId) return "is-failed";
        return "";
    }

    private static string PaletteClass(BlockKind kind) => kind switch
    {
        BlockKind.MoveForward                         => "move",
        BlockKind.Repeat or BlockKind.RepeatUntilFlag => "loop",
        BlockKind.If                                  => "if",
        _                                             => "turn"
    };

    private static string BoardMark(BoardState state) => state switch
    {
        BoardState.Passed => "✓",
        BoardState.Failed => "✕",
        _                 => ""
    };

    private static string StarText(int stars, bool showEmpty = false) =>
        stars == 0 && !showEmpty ? "" : new string('★', stars) + new string('☆', 3 - stars);

    private static string LevelLabel(Level l, bool unlocked, int stars) =>
        !unlocked ? $"Level {l.Number}, locked"
        : stars > 0 ? $"Level {l.Number}, {l.Title}, {stars} of 3 stars"
        : $"Level {l.Number}, {l.Title}";
}
