@page "/"
@implements IDisposable
@using WhatTheCode.Models
@using WhatTheCode.Services
@inject ProgressStore Progress
@inject IJSRuntime JS
@inject BadgeStore Badges
@inject DraftLevel Draft
@inject NavigationManager Nav

<PageTitle>What the CODE? · Level @_level.Number</PageTitle>

<div class="play">
    <header class="topbar">
        <h1 class="logo">What the <span>CODE?</span></h1>

        <nav class="level-path" aria-label="Levels">
            <ol>
                @foreach (var level in LevelCatalog.All)
                {
                    var l = level;
                    var unlocked = Progress.IsUnlocked(l.Number);
                    var stars = Progress.StarsFor(l.Number);
                    <li class="@(l.Number == PartTwoStart ? "part-start" : "")">
                        <button type="button"
                                class="level-stop @(l == _level ? "is-current" : "") @(stars > 0 ? "is-solved" : "")"
                                disabled="@(!unlocked || _running)"
                                aria-current="@(l == _level ? "step" : null)"
                                aria-label="@LevelLabel(l, unlocked, stars)"
                                @onclick="() => SelectLevel(l)">
                            <span class="level-num">@(unlocked ? l.Number.ToString() : "🔒")</span>
                            <span class="level-stars" aria-hidden="true">@StarText(stars)</span>
                        </button>
                    </li>
                }
            </ol>
        </nav>

        <div class="top-actions">
            <button type="button" class="top-btn" @onclick="() => _showBadges = true" aria-label="Badges: @Badges.Count of @BadgeCatalog.All.Count earned">
                <span aria-hidden="true">🏅</span><span class="top-btn-text">@Badges.Count/@BadgeCatalog.All.Count</span>
            </button>
            <a class="top-btn" href="make" aria-label="Make your own level">
                <span aria-hidden="true">🛠️</span><span class="top-btn-text wide-only">Make</span>
            </a>
        </div>
    </header>

    @if (_customProblem is not null)
    {
        <p class="link-problem" role="alert">@_customProblem Here's the main game instead.</p>
    }

    <main class="stage">
        <section class="intro" aria-labelledby="level-title">
            <h2 id="level-title" class="level-title">
                <span class="level-tag">@(_testing ? "Testing your level" : _level.IsCustom ? "Player-made level" : $"Level {_level.Number}")</span>
                @_level.Title
            </h2>

            @if (_level.NewIdea is not null)
            {
                <p class="new-idea"><strong>New idea.</strong> @_level.NewIdea</p>
            }
        </section>

        <section class="board-panel" aria-label="Board">
            @if (_sessions.Count > 1)
            {
                <div class="board-tabs" role="tablist" aria-label="Boards">
                    <span class="board-tabs-note">One program has to solve all @_sessions.Count boards.</span>
                    <span class="board-tabs-note-short" aria-hidden="true">Solve all:</span>
                    @for (int i = 0; i < _sessions.Count; i++)
                    {
                        var index = i;
                        <button type="button" role="tab"
                                class="board-tab board-@_boardStates[index].ToString().ToLowerInvariant()"
                                aria-selected="@(index == _shown ? "true" : "false")"
                                disabled="@_running"
                                @onclick="() => _shown = index">
                            Board @(index + 1)
                            <span aria-hidden="true">@BoardMark(_boardStates[index])</span>
                        </button>
                    }
                </div>
            }

            @* Tapping the board doesn't move the bot, so explain what does. *@
            <div class="board-wrap" @onclick="NudgeAsync">
                <GameGrid Session="ShownSession" Crashed="_crashedBoard == _shown" Celebrating="_status.Kind == StatusKind.Success"
                          Ghost="@(_answerRevealed ? _answerPaths[_shown] : null)" />
            </div>

            @if (_nudge)
            {
                <p class="nudge" role="status">The bot only follows your program. @(_mode == EditMode.Code ? "Write it below" : "Tap a block to add it"), then press Run.</p>
            }
            else
            {
            <div class="status status-@_status.Kind.ToString().ToLowerInvariant() @(_paused ? "is-paused" : "")" role="status" aria-live="polite">
                @if (_paused)
                {
                    <span class="paused-tag">Paused</span>
                }
                @if (_status.Kind == StatusKind.Success)
                {
                    <p class="stars-earned" aria-label="@_earnedStars of 3 stars">@StarText(_earnedStars, showEmpty: true)</p>
                }
                <p>@_status.Message</p>
                @if (_status.Kind == StatusKind.Success && _testing && _shareLink is not null)
                {
                    <div class="share">
                        <input class="share-link" readonly value="@_shareLink" aria-label="Link to your level" @onfocus="SelectShareLink" />
                        <div class="share-actions">
                            <button type="button" class="btn btn-next" @onclick="CopyShareLinkAsync">@(_copied ? "✓ Copied" : "Copy link")</button>
                            <a class="btn btn-quiet" href="make">Back to editor</a>
                        </div>
                    </div>
                }
                else if (_status.Kind == StatusKind.Success && _level.IsCustom)
                {
                    <a class="btn btn-next" href="make">Make your own level</a>
                }
                else if (_status.Kind == StatusKind.Success && NextLevel is not null)
                {
                    <button type="button" class="btn btn-next" @onclick="() => SelectLevel(NextLevel)">Next level</button>
                }
                else if (_status.Kind == StatusKind.Success)
                {
                    <p class="all-done">That's every level so far. Try getting three stars on each one, or <a href="make">make your own level</a>.</p>
                }
            </div>
            }
        </section>

        <section class="help-panel" aria-label="Tips and hints">
            <p class="tip">@_level.Tip</p>
            @if (_testing)
            {
                <a class="back-to-editor" href="make">← Back to the editor</a>
            }

            @if (!_level.IsCustom)
            {
            <div class="help" aria-live="polite">
                @for (int i = 0; i < _hintsShown; i++)
                {
                    <p class="hint"><strong>Hint @(i + 1).</strong> @_level.Hints[i]</p>
                }

                @if (_answerRevealed)
                {
                    <div class="help-box answer">
                        <p>
                            The dotted rings on the board show the route the answer takes@(_sessions.Count > 1 ? ". Switch boards to see each one." : ".")
                        </p>
                        <button type="button" class="btn btn-quiet" disabled="@_running" @onclick="LoadAnswer">Put the answer in my program</button>
                    </div>
                }
                else if (_confirmingAnswer)
                {
                    <div class="help-box confirm">
                        <p>If you see the answer, solving this level earns 1 star this time. You can always replay it on your own for 3.</p>
                        <div class="help-actions">
                            <button type="button" class="btn btn-reveal" @onclick="RevealAnswer">Show the answer</button>
                            <button type="button" class="btn btn-quiet" @onclick="() => _confirmingAnswer = false">Keep trying</button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="help-actions">
                        @if (_hintsShown < _level.Hints.Count)
                        {
                            <button type="button" class="btn btn-quiet btn-small" @onclick="() => _hintsShown++">
                                @(_hintsShown == 0 ? "Stuck? Show a hint" : "Show another hint")
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-quiet btn-small" @onclick="() => _confirmingAnswer = true">Show the answer</button>
                        }
                    </div>
                }
            </div>
            }
        </section>

        <section class="workshop" aria-label="Build your program">
            @* On phones the dock is pinned to the bottom of the screen, within thumb reach. *@
            <div class="dock">
                <div class="palette">
                    <h3 class="palette-title">@(_mode == EditMode.Code ? "Snippets" : "Blocks")</h3>
                    <div class="palette-blocks @(_nudge || ShowFirstTimeHint ? "is-nudged" : "")">
                        @foreach (var kind in _level.Blocks)
                        {
                            var k = kind;
                            @if (_mode == EditMode.Code)
                            {
                                <button type="button" class="palette-block palette-code palette-@PaletteClass(k)"
                                        disabled="@_running"
                                        title="Insert at the cursor"
                                        @onclick="() => InsertSnippetAsync(k)">
                                    @SnippetLabel(k)
                                </button>
                            }
                            else
                            {
                                <button type="button" class="palette-block palette-@PaletteClass(k)"
                                        disabled="@(_running || !CanAdd(k))"
                                        @onclick="() => AddBlock(k)">
                                    + @Instruction.LabelFor(k)
                                </button>
                            }
                        }
                    </div>
                </div>

                <div class="run-controls">
                    @if (!_running)
                    {
                        <button type="button" class="btn btn-run" disabled="@(!CanRun)" @onclick="() => RunAsync()">▶ Run</button>
                        <button type="button" class="btn btn-quiet" disabled="@(!CanRun)" @onclick="StepAsync"
                                title="Run one block at a time">Step</button>
                        <button type="button" class="btn btn-quiet" @onclick="ResetBoards" title="Put the bot back at the start">Reset</button>
                        <button type="button" class="btn btn-quiet" disabled="@(_program.Count == 0 && string.IsNullOrWhiteSpace(_codeText))" @onclick="ClearProgram">Clear</button>
                    }
                    else
                    {
                        @if (_paused)
                        {
                            <button type="button" class="btn btn-run" @onclick="Resume">▶ Resume</button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-pause" @onclick="Pause">❚❚ Pause</button>
                        }
                        <button type="button" class="btn btn-quiet" @onclick="StepAsync" title="Run the next block, then pause">Step</button>
                        <button type="button" class="btn btn-stop" @onclick="Stop">■ Stop</button>
                    }
                    <button type="button" class="btn btn-quiet btn-speed" @onclick="CycleSpeed"
                            aria-label="Speed: @SpeedName. Tap to change." title="Speed: @SpeedName (tap to change)">
                        <span aria-hidden="true">@SpeedIcon</span>
                    </button>
                </div>
            </div>

            <div class="program">
                <div class="program-head">
                    <h3>Your program</h3>
                    <div class="mode-toggle" role="radiogroup" aria-label="How to write your program">
                        <button type="button" role="radio" aria-checked="@(_mode == EditMode.Blocks ? "true" : "false")"
                                class="@(_mode == EditMode.Blocks ? "is-on" : "")" disabled="@_running"
                                @onclick="() => SetModeAsync(EditMode.Blocks)">Blocks</button>
                        <button type="button" role="radio" aria-checked="@(_mode == EditMode.Code ? "true" : "false")"
                                class="@(_mode == EditMode.Code ? "is-on" : "")" disabled="@_running"
                                @onclick="() => SetModeAsync(EditMode.Code)">Code</button>
                    </div>
                </div>
                <p class="block-count">@BlocksUsed @(BlocksUsed == 1 ? "block" : "blocks") · par @_level.Par</p>

                @if (_mode == EditMode.Code)
                {
                    <div class="editor @(_codeError is not null ? "has-error" : "")">
                        <div class="gutter" aria-hidden="true">
                            @for (int n = 1; n <= EditorLineCount; n++)
                            {
                                <span class="@GutterClass(n)">@n</span>
                            }
                        </div>
                        @if (_running)
                        {
                            <pre class="editor-view" aria-label="Your program in C#, running">@for (int n = 1; n <= CodeTextLines.Length; n++)
{var lineNo = n;<span class="editor-line @LineState(lineNo)">@CodeTextLines[lineNo - 1]@if (LineNote(lineNo) is { } note){<span class="line-note @note.Css">@note.Text</span>}
</span>}</pre>
                        }
                        else
                        {
                            <textarea id="code-editor" class="editor-input" rows="@EditorLineCount"
                                      spellcheck="false" autocapitalize="off" autocomplete="off" autocorrect="off" wrap="off"
                                      aria-label="Your program in C#" aria-describedby="code-help"
                                      placeholder="@CodePlaceholder"
                                      value="@_codeText" @oninput="OnCodeInput"></textarea>
                        }
                    </div>

                    @if (_codeError is not null)
                    {
                        <p class="code-error" role="alert"><strong>Line @_codeError.Line:</strong> @_codeError.Message</p>
                    }
                    @if (_switchBlocked)
                    {
                        <p class="code-error-note">Fix that first, then switch to blocks. Your blocks have to match your code.</p>
                    }
                    <p id="code-help" class="code-help">Snippets drop in at your cursor. Tab indents, Enter keeps your indentation.</p>
                }
                else
                {

                @if (_target is not null && !_running)
                {
                    var owner = FindOwner(_target, _program);
                    <p class="target-note">
                        Adding inside @TargetName(owner).
                        <button type="button" class="link-btn" disabled="@_running" @onclick="StepOut">Add after that block</button>
                        @if (owner?.Parent != _program)
                        {
                            <span aria-hidden="true"> · </span>
                            <button type="button" class="link-btn" disabled="@_running" @onclick="() => SelectTarget(null)">Add to the end</button>
                        }
                    </p>
                }

                <div class="program-list @(_target is null && !_running ? "is-target" : "")"
                     @onclick="() => SelectTarget(null)">
                    @if (_program.Count == 0)
                    {
                        <p class="program-empty">Tap a block to add it to your program.</p>
                    }
                    else
                    {
                        <BlockList Items="_program" Target="_target" ActiveId="_activeId" FailedId="_failedId"
                                   Passes="_passes" Check="_check"
                                   Disabled="_running"
                                   OnRemove="RemoveBlock" OnSelectTarget="SelectTarget"
                                   OnCountChange="ChangeCount" OnCycleCondition="CycleCondition" />
                    }
                </div>
                }
            </div>

            @if (_mode == EditMode.Blocks)
            {
            <div class="bridge">
                <h3>Your program in C#</h3>
                <pre class="code" aria-label="Generated C# code"><code>@foreach (var line in CodeGenerator.Generate(_program))
{<span class="code-line @LineClass(line)">@line.Text
</span>}</code></pre>
            </div>
            }
        </section>
    </main>

    @if (_toast is not null)
    {
        <div class="toast" role="status" aria-live="polite">
            <span class="toast-title">Badge earned!</span>
            @foreach (var b in _toast)
            {
                <span class="toast-badge"><span aria-hidden="true">@b.Emoji</span> @b.Name</span>
            }
        </div>
    }

    @if (_showBadges)
    {
        <div class="overlay" @onclick="() => _showBadges = false" @onkeydown="CabinetKey">
            <div class="cabinet" role="dialog" aria-modal="true" aria-labelledby="cabinet-title" @onclick:stopPropagation="true">
                <div class="cabinet-head">
                    <h2 id="cabinet-title">Badges <span class="cabinet-count">@Badges.Count of @BadgeCatalog.All.Count</span></h2>
                    <button type="button" class="chip-close cabinet-close" aria-label="Close" @onclick="() => _showBadges = false">✕</button>
                </div>
                <ul class="badge-list">
                    @foreach (var badge in BadgeCatalog.All)
                    {
                        var earned = Badges.Has(badge.Id);
                        <li class="badge @(earned ? "is-earned" : "")">
                            <span class="badge-emoji" aria-hidden="true">@(earned ? badge.Emoji : "🔒")</span>
                            <span class="badge-text">
                                <strong>@badge.Name</strong>
                                <span>@badge.HowToEarn</span>
                            </span>
                            <span class="visually-hidden">@(earned ? "Earned" : "Not earned yet")</span>
                        </li>
                    }
                </ul>
            </div>
        </div>
    }
</div>

@code {
    private enum StatusKind { Idle, Running, Success, Fail }
    private enum BoardState { Untried, Passed, Failed }
    private record Status(StatusKind Kind, string Message);

    private enum Speed { Slow, Normal, Fast }
    private enum EditMode { Blocks, Code }
    private record LineNoteInfo(string Text, string Css);

    private const string ModeKey = "whatthecode.mode";

    private const int BetweenBoardsMs = 650;
    private const int MaxNesting = 3;
    private const int PartTwoStart = 7;

    private const string ReadyEmpty = "Build a program, then press Run.";
    private const string ReadyToRun = "Ready. Press Run to try it.";

    private Level _level = LevelCatalog.All[0];
    private List<GameSession> _sessions = new();
    private BoardState[] _boardStates = Array.Empty<BoardState>();
    private int _shown;

    private List<Instruction> _program = new();
    private List<Instruction>? _target; // null means "end of the main program"

    private bool _running;
    private int? _crashedBoard;
    private Guid? _activeId;
    private Guid? _failedId;
    private int _earnedStars;

    // Help: hints are free; seeing the answer caps this solve at one star.
    private int _hintsShown;
    private bool _confirmingAnswer;
    private bool _answerRevealed;
    private List<HashSet<Cell>> _answerPaths = new();

    // Phone helpers
    private bool _nudge;
    private CancellationTokenSource? _nudgeCts;
    private bool _scrollLevelStrip = true;
    private Guid? _revealBlockId;
    private Guid? _lastFollowed;

    /// <summary>On the very first level, gently point at the blocks until something is added.</summary>
    private bool ShowFirstTimeHint => _mode == EditMode.Blocks && _level.Number == 1 && _program.Count == 0 && !_running && !Progress.IsSolved(1);
    private CancellationTokenSource? _cts;

    // Debugging: pause, step, speed, and what the program just decided.
    private Speed _speed = Speed.Normal;
    private bool _paused;
    private TaskCompletionSource? _gate;
    private string? _decision;
    private string? _lastAction;
    private (Guid Id, bool Answer)? _check;
    private IReadOnlyDictionary<Guid, int>? _passes;

    // Player-made levels and badges
    [SupplyParameterFromQuery(Name = "custom")] public string? CustomCode { get; set; }
    [SupplyParameterFromQuery(Name = "test")] public string? TestFlag { get; set; }

    private bool _testing;          // solving a level from the editor to set its par
    private string? _shareLink;
    private bool _copied;
    private string? _customProblem;
    private bool _showBadges;
    private bool _cabinetWasOpen;
    private List<Badge>? _toast;
    private CancellationTokenSource? _toastCts;
    private bool _usedStep;
    private int _failedRuns;

    // Pro mode: the program as typed C#.
    private EditMode _mode = EditMode.Blocks;
    private string _codeText = "";
    private CodeError? _codeError;
    private IReadOnlyDictionary<Guid, int> _codeLines = new Dictionary<Guid, int>();
    private bool _switchBlocked;

    private bool CanRun => _program.Count > 0 && (_mode == EditMode.Blocks || _codeError is null);
    private string[] CodeTextLines => _codeText.Replace("\r", "").Split('\n');
    private int EditorLineCount => Math.Max(6, CodeTextLines.Length + 1);
    private const string CodePlaceholder = "// Type C# here, or tap a snippet.";

    private int StepDelayMs => _speed switch { Speed.Slow => 800, Speed.Fast => 140, _ => 380 };
    private int CheckDelayMs => _speed switch { Speed.Slow => 650, Speed.Fast => 90, _ => 260 };
    private string SpeedName => _speed switch { Speed.Slow => "Slow", Speed.Fast => "Fast", _ => "Normal" };
    private string SpeedIcon => _speed switch { Speed.Slow => "🐢", Speed.Fast => "🐇", _ => "🚶" };
    private Status _status = new(StatusKind.Idle, ReadyEmpty);

    private GameSession ShownSession => _sessions[_shown];
    private int BlocksUsed => Instruction.CountBlocks(_program);
    private Level? NextLevel => LevelCatalog.All.FirstOrDefault(l => l.Number == _level.Number + 1);

    protected override void OnInitialized() => LoadLevel(LevelCatalog.All[0]);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Progress.LoadAsync();
            try
            {
                if (await JS.InvokeAsync<string?>("localStorage.getItem", ModeKey) == nameof(EditMode.Code))
                    _mode = EditMode.Code;
            }
            catch (JSException) { /* stay in blocks */ }

            await Badges.LoadAsync();

            if (TestFlag == "1" && Draft.Spec is { } draft)
            {
                LoadLevel(CustomLevels.ToLevel(draft));
                _testing = true;
            }
            else if (CustomCode is not null && CustomLevels.Decode(CustomCode, out var problem) is { } shared)
            {
                LoadLevel(CustomLevels.ToLevel(shared));
            }
            else
            {
                if (CustomCode is not null) _customProblem = "That level link didn't work.";
                var resumeAt = LevelCatalog.All.FirstOrDefault(l => !Progress.IsSolved(l.Number)) ?? LevelCatalog.All[^1];
                LoadLevel(resumeAt);
            }
            StateHasChanged();
            return;
        }

        try
        {
            if (_scrollLevelStrip)
            {
                _scrollLevelStrip = false;
                await JS.InvokeVoidAsync("wtc.showCurrentLevel");
            }

            if (_revealBlockId is { } id)
            {
                _revealBlockId = null;
                await JS.InvokeVoidAsync("wtc.revealBlock", id.ToString(), 150);
            }

            // While stepping (or after a crash), keep the highlighted block or line in view.
            var follow = _paused ? _activeId : _failedId;
            if (follow is { } focus && focus != _lastFollowed)
            {
                _lastFollowed = focus;
                if (_mode == EditMode.Code)
                    await JS.InvokeVoidAsync("wtc.revealSelector", ".editor-line.is-active");
                else
                    await JS.InvokeVoidAsync("wtc.revealBlock", focus.ToString(), 56);
            }

            if (_mode == EditMode.Code && !_running)
                await JS.InvokeVoidAsync("wtc.enhanceEditor", "code-editor");

            // Move keyboard focus into the badge cabinet when it opens.
            if (_showBadges != _cabinetWasOpen)
            {
                _cabinetWasOpen = _showBadges;
                if (_showBadges) await JS.InvokeVoidAsync("wtc.focus", ".cabinet-close");
            }
        }
        catch (JSException)
        {
            // Scrolling helpers are cosmetic; never let them break the game.
        }
    }

    /// <summary>Someone tapped the board expecting it to move the bot. Point them at the blocks instead.</summary>
    private async Task NudgeAsync()
    {
        if (_running) return;

        _nudgeCts?.Cancel();
        _nudgeCts = new CancellationTokenSource();
        var token = _nudgeCts.Token;
        _nudge = true;

        try
        {
            await Task.Delay(4000, token);
            _nudge = false;
        }
        catch (OperationCanceledException)
        {
            // A newer tap restarted the timer.
        }
    }

    // ---------- Levels ----------

    private void SelectLevel(Level level)
    {
        if (_running || !Progress.IsUnlocked(level.Number)) return;
        var leavingCustom = _level.IsCustom;
        _testing = false;
        _customProblem = null;
        LoadLevel(level);
        if (leavingCustom) Nav.NavigateTo(Nav.BaseUri, replace: true);
    }

    private void LoadLevel(Level level)
    {
        _level = level;
        _sessions = level.Boards.Select(b => new GameSession(b)).ToList();
        _boardStates = new BoardState[_sessions.Count];
        _shown = 0;
        _program = new();
        _target = null;
        _hintsShown = 0;
        _confirmingAnswer = false;
        _answerRevealed = false;
        _answerPaths = new();
        _nudge = false;
        _scrollLevelStrip = true;
        _codeText = "";
        _codeError = null;
        _codeLines = new Dictionary<Guid, int>();
        _switchBlocked = false;
        _shareLink = null;
        _copied = false;
        _usedStep = false;
        _failedRuns = 0;
        ClearRunState();
        _status = new(StatusKind.Idle, ReadyEmpty);
    }

    // ---------- Help ----------

    private void RevealAnswer()
    {
        _answerPaths = _level.Boards.Select(b => SolutionPath.Trace(b, _level.Solution())).ToList();
        _answerRevealed = true;
        _confirmingAnswer = false;
    }

    private void LoadAnswer()
    {
        if (_running) return;
        if (_mode == EditMode.Code)
        {
            ApplyCode(TextOf(_level.Solution()));
            return;
        }
        _program = _level.Solution();
        _target = null;
        OnProgramEdited();
    }

    // ---------- Editing ----------

    private bool CanAdd(BlockKind kind) =>
        !new Instruction(kind).IsContainer || Depth(_target) < MaxNesting;

    private void AddBlock(BlockKind kind)
    {
        if (_running || !CanAdd(kind)) return;

        var block = new Instruction(kind);
        (_target ?? _program).Add(block);

        if (block.IsContainer) _target = block.Body; // next blocks go inside the new block
        _nudge = false;
        _revealBlockId = block.Id;
        OnProgramEdited();
    }

    private void RemoveBlock(Instruction block)
    {
        if (_running) return;

        if (_target is not null && block.ChildLists.Any(l => l == _target || ContainsList(l, _target)))
            _target = null;

        RemoveFrom(_program, block);
        OnProgramEdited();
    }

    private void ChangeCount((Instruction Block, int Delta) change)
    {
        if (_running) return;
        change.Block.ChangeCount(change.Delta);
        OnProgramEdited();
    }

    private void CycleCondition(Instruction block)
    {
        if (_running) return;
        block.CycleCondition();
        OnProgramEdited();
    }

    private void SelectTarget(List<Instruction>? list)
    {
        if (_running) return;
        _target = list;
    }

    /// <summary>Move the insertion point to just after the block that owns the current target.</summary>
    private void StepOut()
    {
        if (_running || _target is null) return;
        var parent = FindOwner(_target, _program)?.Parent;
        _target = parent == _program ? null : parent;
    }

    private void ClearProgram()
    {
        if (_mode == EditMode.Code)
        {
            ApplyCode("");
            return;
        }
        _program.Clear();
        _target = null;
        OnProgramEdited();
    }

    private void OnProgramEdited()
    {
        ResetBoards();
    }

    // ---------- Running ----------

    private async Task RunAsync(bool startPaused = false)
    {
        if (_running || _program.Count == 0) return;

        ResetBoards();
        _running = true;
        _paused = startPaused;
        _cts = new CancellationTokenSource();
        var token = _cts.Token;
        ShowRunStatus();

        try
        {
            for (int board = 0; board < _sessions.Count; board++)
            {
                _shown = board;
                var session = _sessions[board];
                var runner = new ProgramRunner(session);
                var prefix = _sessions.Count > 1 ? $"Board {board + 1}: " : "";
                _passes = runner.Passes;

                StateHasChanged();
                if (board == 0) await Task.Delay(150, token);
                else await WaitAsync(BetweenBoardsMs, token);

                foreach (var step in runner.Run(_program))
                {
                    _activeId = step.Source.Id;

                    if (step.IsAction)
                    {
                        _check = null;
                        _decision = null;
                        _lastAction = step.Action switch
                        {
                            BlockKind.TurnLeft  => "Turned left.",
                            BlockKind.TurnRight => "Turned right.",
                            _                   => "Moved forward."
                        };
                        var outcome = session.Apply(step.Action);

                        if (outcome is StepOutcome.HitWall or StepOutcome.HitEdge)
                        {
                            Fail(board, step.Source.Id, prefix + (outcome == StepOutcome.HitWall
                                ? "Bonk! The highlighted block drove the bot into a wall."
                                : "Whoa, the highlighted block tried to drive off the edge of the board."));
                            return;
                        }
                    }
                    else
                    {
                        _check = (step.Source.Id, step.Answer);
                        _decision = Explain(step);
                        _lastAction = null;
                    }

                    ShowRunStatus();
                    StateHasChanged();
                    await WaitAsync(step.IsAction ? StepDelayMs : CheckDelayMs, token);
                }

                _activeId = null;
                _check = null;
                _decision = null;

                if (runner.RanOutOfSteps)
                {
                    Fail(board, null, prefix + "The bot went around in circles and never got there. Check that your loop can actually reach the flag.");
                    return;
                }

                if (!session.OnFlag)
                {
                    Fail(board, null, prefix + "The program finished, but the bot isn't on the flag. Add more blocks or check your turns.");
                    return;
                }

                _boardStates[board] = BoardState.Passed;
            }

            await CompleteLevelAsync();
        }
        catch (OperationCanceledException)
        {
            _activeId = null;
            _status = new(StatusKind.Idle, "Stopped. Change your program or press Run again.");
        }
        finally
        {
            _running = false;
            _paused = false;
            _gate = null;
            _check = null;
            _passes = null;
            _decision = null;
            _lastAction = null;
            _cts?.Dispose();
            _cts = null;
            StateHasChanged();
        }
    }

    /// <summary>Waits between steps. While paused, waits until Step or Resume instead.</summary>
    private async Task WaitAsync(int ms, CancellationToken token)
    {
        if (!_paused)
        {
            await Task.Delay(ms, token);
            if (!_paused) return; // Pause was pressed mid-delay: fall through and hold here
        }

        _gate = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
        ShowRunStatus();
        StateHasChanged();

        using (token.Register(() => _gate?.TrySetCanceled()))
            await _gate.Task;

        _gate = null;
    }

    private void Pause()
    {
        if (!_running || _paused) return;
        _paused = true;
        ShowRunStatus();
    }

    private void Resume()
    {
        if (!_running) return;
        _paused = false;
        ShowRunStatus();
        _gate?.TrySetResult();
    }

    /// <summary>Runs the next block, then pauses. Starts a paused run if nothing is running.</summary>
    private async Task StepAsync()
    {
        _usedStep = true;
        if (!_running)
        {
            await RunAsync(startPaused: true);
            return;
        }

        if (!_paused)
        {
            Pause();
            return;
        }

        _gate?.TrySetResult();
    }

    private void CycleSpeed() =>
        _speed = _speed switch { Speed.Slow => Speed.Normal, Speed.Normal => Speed.Fast, _ => Speed.Slow };

    private void ShowRunStatus()
    {
        var message = _decision
            ?? (_paused
                ? (_lastAction ?? "Ready.") + " Step runs the next block. Resume carries on from here."
                : "Running…");
        _status = new(StatusKind.Running, message);
    }

    /// <summary>Says out loud what an If or Repeat-until just decided, and what happens next.</summary>
    private static string Explain(ProgramStep step)
    {
        var block = step.Source;

        if (block.Kind == BlockKind.RepeatUntilFlag)
            return step.Answer
                ? "At the flag? Yes, so the loop stops."
                : "At the flag? Not yet, so the loop goes again.";

        var question = char.ToUpper(block.ConditionLabel[0]) + block.ConditionLabel[1..] + "?";

        if (step.Answer)
            return block.Body.Count > 0
                ? $"{question} Yes, so the top part runs."
                : $"{question} Yes, but the top part is empty, so nothing happens.";

        return block.ElseBody.Count > 0
            ? $"{question} No, so the Otherwise part runs."
            : $"{question} No, and there's no Otherwise part, so it skips ahead.";
    }

    private void Fail(int board, Guid? blockId, string message)
    {
        _paused = false;
        _failedRuns++;
        _boardStates[board] = BoardState.Failed;
        _activeId = null;
        _failedId = blockId;
        if (blockId is not null) _crashedBoard = board;
        _status = new(StatusKind.Fail, message);
    }

    private async Task CompleteLevelAsync()
    {
        var used = BlocksUsed;
        var where = _sessions.Count > 1 ? $"on all {_sessions.Count} boards " : "";
        var earned = new List<Badge>();
        async Task Award(string id) { if (await Badges.AwardAsync(id) is { } b) earned.Add(b); }

        if (_testing && Draft.Spec is { } draft)
        {
            // The maker's own solve sets the par to beat.
            Draft.Spec = draft with { Par = used };
            _shareLink = $"{Nav.BaseUri}?custom={CustomLevels.Encode(Draft.Spec)}";
            _earnedStars = 3;
            _status = new(StatusKind.Success, $"Your level works! Par is set to {used} {(used == 1 ? "block" : "blocks")}. Share the link and see who can match it.");
            await Award(BadgeCatalog.LevelMaker);
        }
        else if (_level.IsCustom)
        {
            _earnedStars = _level.StarsFor(used);
            _status = new(StatusKind.Success,
                used < _level.Par ? $"You beat it with {used} {(used == 1 ? "block" : "blocks")}. That's better than the maker's {_level.Par}!"
                : used == _level.Par ? $"You beat it with {used} {(used == 1 ? "block" : "blocks")}, matching the maker's par. Nice."
                : $"You beat it with {used} blocks. The maker did it in {_level.Par}. Can you get there?");
            await Award(BadgeCatalog.GuestStar);
        }
        else
        {
            _earnedStars = _answerRevealed ? 1 : _level.StarsFor(used);
            await Progress.RecordAsync(_level.Number, _earnedStars);

            _status = new(StatusKind.Success, _answerRevealed
                ? $"Flag reached {where}with the answer's help, so this one's worth 1 star. Replay it on your own for 3."
                : used <= _level.Par
                ? $"Flag reached {where}with {used} {(used == 1 ? "block" : "blocks")}. That's par. Nicely done."
                : $"Flag reached {where}with {used} blocks. Par is {_level.Par}. Can you do it with fewer?");

            await Award(BadgeCatalog.FirstFlag);
            if (!_answerRevealed && _hintsShown == 0 && _level.Number >= 7) await Award(BadgeCatalog.NoHints);
            if (_level.Number == 12) await Award(BadgeCatalog.MazeMaster);
            if (AllThreeStars(1, 6)) await Award(BadgeCatalog.PartOne);
            if (AllThreeStars(7, 12)) await Award(BadgeCatalog.PartTwo);
        }

        if (_usedStep) await Award(BadgeCatalog.BugHunter);
        if (_mode == EditMode.Code) await Award(BadgeCatalog.ProCoder);
        if (_failedRuns >= 5) await Award(BadgeCatalog.NeverGiveUp);

        if (earned.Count > 0) _ = ShowToastAsync(earned);
    }

    private bool AllThreeStars(int from, int to) =>
        Enumerable.Range(from, to - from + 1).All(n => Progress.StarsFor(n) == 3);

    private async Task ShowToastAsync(List<Badge> badges)
    {
        _toastCts?.Cancel();
        _toastCts = new CancellationTokenSource();
        var token = _toastCts.Token;
        _toast = badges;
        StateHasChanged();
        try
        {
            await Task.Delay(4500, token);
            _toast = null;
            StateHasChanged();
        }
        catch (OperationCanceledException) { }
    }

    private void CabinetKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") _showBadges = false;
    }

    private async Task CopyShareLinkAsync()
    {
        if (_shareLink is null) return;
        try { _copied = await JS.InvokeAsync<bool>("wtc.copy", _shareLink); }
        catch (JSException) { _copied = false; }
    }

    private async Task SelectShareLink()
    {
        try { await JS.InvokeVoidAsync("wtc.selectAll", ".share-link"); }
        catch (JSException) { }
    }

    private void Stop() => _cts?.Cancel();

    private void ResetBoards()
    {
        foreach (var s in _sessions) s.Reset();
        _boardStates = new BoardState[_sessions.Count];
        ClearRunState();
        _status = new(StatusKind.Idle,
            _mode == EditMode.Code && _codeError is not null ? "Fix the line marked in red, then press Run."
            : _program.Count == 0 ? ReadyEmpty
            : ReadyToRun);
    }

    // ---------- Pro mode (typed C#) ----------

    private async Task SetModeAsync(EditMode mode)
    {
        if (_running || mode == _mode) return;

        if (mode == EditMode.Code)
        {
            _mode = EditMode.Code;
            ApplyCode(TextOf(_program)); // your blocks, written out as C#
        }
        else
        {
            if (_codeError is not null)
            {
                _switchBlocked = true;
                return;
            }
            _mode = EditMode.Blocks;
            _target = null;
            ResetBoards();
        }

        _nudge = false;
        try { await JS.InvokeVoidAsync("localStorage.setItem", ModeKey, mode.ToString()); }
        catch (JSException) { /* preference just won't stick */ }
    }

    private void OnCodeInput(ChangeEventArgs e) => ApplyCode(e.Value?.ToString() ?? "");

    /// <summary>Reads the typed code. If it's valid for this level, it becomes the program.</summary>
    private void ApplyCode(string text)
    {
        _codeText = text;
        _switchBlocked = false;

        var result = CodeParser.Parse(text);
        _codeError = result.Error
            ?? CodeParser.CheckAllowed(result.Program!, _level.Blocks.ToHashSet(), result.Lines, _level.Number);

        if (_codeError is null)
        {
            _program = result.Program!;
            _codeLines = result.Lines;
            _target = null;
        }

        ResetBoards();
    }

    private async Task InsertSnippetAsync(BlockKind kind)
    {
        if (_running) return;
        try { await JS.InvokeVoidAsync("wtc.insertSnippet", "code-editor", SnippetFor(kind)); }
        catch (JSException) { ApplyCode(_codeText + (_codeText.Length > 0 ? "\n" : "") + SnippetFor(kind).Replace("$0", "")); }
    }

    private static string TextOf(IReadOnlyList<Instruction> program) =>
        program.Count == 0 ? "" : string.Join("\n", CodeGenerator.Generate(program).Select(l => l.Text));

    private static string SnippetFor(BlockKind kind) => kind switch
    {
        BlockKind.MoveForward     => "bot.MoveForward();$0",
        BlockKind.TurnLeft        => "bot.TurnLeft();$0",
        BlockKind.TurnRight       => "bot.TurnRight();$0",
        BlockKind.Repeat          => "for (int i = 0; i < 3; i++)\n{\n    $0\n}",
        BlockKind.RepeatUntilFlag => "while (!bot.AtFlag())\n{\n    $0\n}",
        BlockKind.If              => "if (bot.PathAhead())\n{\n    $0\n}\nelse\n{\n    \n}",
        _                         => ""
    };

    private static string SnippetLabel(BlockKind kind) => kind switch
    {
        BlockKind.MoveForward     => "MoveForward();",
        BlockKind.TurnLeft        => "TurnLeft();",
        BlockKind.TurnRight       => "TurnRight();",
        BlockKind.Repeat          => "for loop",
        BlockKind.RepeatUntilFlag => "while loop",
        BlockKind.If              => "if / else",
        _                         => kind.ToString()
    };

    private int? LineOf(Guid? id) => id is { } g && _codeLines.TryGetValue(g, out var line) ? line : null;

    private string GutterClass(int line) =>
        _codeError?.Line == line ? "is-error"
        : _running && LineOf(_activeId) == line ? "is-active"
        : LineOf(_failedId) == line ? "is-failed"
        : "";

    private string LineState(int line) =>
        LineOf(_activeId) == line ? "is-active"
        : LineOf(_failedId) == line ? "is-failed"
        : "";

    /// <summary>While running: what an if just found, or which pass a loop is on, shown at the end of its line.</summary>
    private LineNoteInfo? LineNote(int line)
    {
        if (_check is { } c && LineOf(c.Id) == line && FindBlock(_program, c.Id) is { } checkedBlock)
        {
            return checkedBlock.Kind == BlockKind.RepeatUntilFlag
                ? new(c.Answer ? "  // ✓ there" : "  // not yet", c.Answer ? "yes" : "no")
                : new(c.Answer ? "  // ✓ yes" : "  // ✗ no", c.Answer ? "yes" : "no");
        }

        if (_passes is null) return null;
        foreach (var (id, pass) in _passes)
        {
            if (LineOf(id) != line || FindBlock(_program, id) is not { } loop) continue;
            return new(loop.Kind == BlockKind.Repeat ? $"  // {pass} of {loop.Count}" : $"  // pass {pass}", "pass");
        }
        return null;
    }

    private static Instruction? FindBlock(IEnumerable<Instruction> list, Guid id)
    {
        foreach (var b in list)
        {
            if (b.Id == id) return b;
            foreach (var child in b.ChildLists)
                if (FindBlock(child, id) is { } found) return found;
        }
        return null;
    }

    private void ClearRunState()
    {
        _crashedBoard = null;
        _activeId = null;
        _failedId = null;
        _earnedStars = 0;
    }

    public void Dispose()
    {
        _toastCts?.Cancel();
        _gate?.TrySetCanceled();
        _cts?.Cancel();
        _cts?.Dispose();
        _nudgeCts?.Cancel();
        _nudgeCts?.Dispose();
    }

    // ---------- Program tree helpers ----------

    /// <summary>The block that owns a child list, and the list that block sits in.</summary>
    private record Owner(Instruction Block, List<Instruction> Parent, bool IsElse);

    private static Owner? FindOwner(List<Instruction> target, List<Instruction> list)
    {
        foreach (var block in list)
        {
            if (block.IsContainer && block.Body == target) return new Owner(block, list, false);
            if (block.Kind == BlockKind.If && block.ElseBody == target) return new Owner(block, list, true);

            foreach (var child in block.ChildLists)
            {
                var found = FindOwner(target, child);
                if (found is not null) return found;
            }
        }
        return null;
    }

    /// <summary>How many container blocks enclose a list (the main program is 0).</summary>
    private int Depth(List<Instruction>? list)
    {
        int depth = 0;
        while (list is not null && list != _program)
        {
            var owner = FindOwner(list, _program);
            if (owner is null) break;
            depth++;
            list = owner.Parent;
        }
        return depth;
    }

    private static bool ContainsList(List<Instruction> haystack, List<Instruction> needle) =>
        haystack.Any(b => b.ChildLists.Any(l => l == needle || ContainsList(l, needle)));

    private static bool RemoveFrom(List<Instruction> list, Instruction target) =>
        list.Remove(target) || list.Any(b => b.ChildLists.Any(l => RemoveFrom(l, target)));

    // ---------- Display helpers ----------

    private static string TargetName(Owner? owner) => owner switch
    {
        null => "a block",
        { Block.Kind: BlockKind.If, IsElse: true } => "the If's Otherwise part",
        { Block.Kind: BlockKind.If } => "the If's yes part",
        _ => $"the {owner.Block.Label}"
    };

    private string LineClass(CodeLine line)
    {
        if (line.SourceId is null || !line.IsStatement) return "";
        if (line.SourceId == _activeId) return "is-active";
        if (line.SourceId == _failedId) return "is-failed";
        return "";
    }

    private static string PaletteClass(BlockKind kind) => kind switch
    {
        BlockKind.MoveForward                         => "move",
        BlockKind.Repeat or BlockKind.RepeatUntilFlag => "loop",
        BlockKind.If                                  => "if",
        _                                             => "turn"
    };

    private static string BoardMark(BoardState state) => state switch
    {
        BoardState.Passed => "✓",
        BoardState.Failed => "✕",
        _                 => ""
    };

    private static string StarText(int stars, bool showEmpty = false) =>
        stars == 0 && !showEmpty ? "" : new string('★', stars) + new string('☆', 3 - stars);

    private static string LevelLabel(Level l, bool unlocked, int stars) =>
        !unlocked ? $"Level {l.Number}, locked"
        : stars > 0 ? $"Level {l.Number}, {l.Title}, {stars} of 3 stars"
        : $"Level {l.Number}, {l.Title}";
}
