@using WhatTheCode.Models
@using WhatTheCode.Services

<div class="board" style="--cols:@Session.Grid.Columns; --rows:@Session.Grid.Rows;"
     role="img" aria-label="@Describe()">
    <div class="cells">
        @for (int row = 0; row < Session.Grid.Rows; row++)
        {
            @for (int col = 0; col < Session.Grid.Columns; col++)
            {
                var isWall = Session.Grid.IsWall(col, row);
                var isFlag = col == Session.Board.Flag.X && row == Session.Board.Flag.Y;
                var isTrail = Session.Grid.Visited[col, row];
                var isGhost = Ghost is not null && !isFlag && Ghost.Contains(new Cell(col, row));

                <div class="cell @(isWall ? "wall" : "") @(isFlag ? "flag" : "") @(isTrail && !isWall ? "trail" : "") @(isGhost ? "ghost" : "")">
                    @if (isFlag)
                    {
                        <span class="flag-icon" aria-hidden="true">🚩</span>
                    }
                </div>
            }
        }
    </div>

    <div class="bot @FacingClass @(Crashed ? "crashed" : "") @(Celebrating ? "celebrating" : "")"
         style="--x:@Session.Bot.X; --y:@Session.Bot.Y;" aria-hidden="true">
        <div class="bot-heading">
            <span class="bot-nose"></span>
        </div>
        <span class="bot-face">🤖</span>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public GameSession Session { get; set; } = default!;
    [Parameter] public bool Crashed { get; set; }
    [Parameter] public bool Celebrating { get; set; }

    /// <summary>Cells on the answer's route, drawn as a dotted trail when the player asks for the answer.</summary>
    [Parameter] public IReadOnlySet<Cell>? Ghost { get; set; }

    private string FacingClass => $"face-{Session.Bot.Facing.ToString().ToLowerInvariant()}";

    private string Describe() =>
        (Ghost is null ? "" : "The answer's route is marked with dotted rings. ") +
        $"{Session.Grid.Columns} by {Session.Grid.Rows} board. Bot at column {Session.Bot.X + 1}, row {Session.Bot.Y + 1}, " +
        $"facing {Session.Bot.Facing.ToString().ToLowerInvariant()}. Flag at column {Session.Board.Flag.X + 1}, row {Session.Board.Flag.Y + 1}.";
}
