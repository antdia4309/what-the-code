@using WhatTheCode.Models

<ol class="blocks">
    @foreach (var item in Items)
    {
        var block = item;
        <li class="block block-@KindClass(block.Kind) @(block.Id == ActiveId ? "is-active" : "") @(block.Id == FailedId ? "is-failed" : "")">
            <div class="block-row">
                @switch (block.Kind)
                {
                    case BlockKind.Repeat:
                        <span class="block-label">Repeat</span>
                        <span class="counter">
                            <button type="button" class="chip-btn" aria-label="Repeat fewer times"
                                    disabled="@(Disabled || block.Count <= Instruction.MinRepeat)"
                                    @onclick="() => OnCountChange.InvokeAsync((block, -1))"
                                    @onclick:stopPropagation="true">−</button>
                            <span class="count" aria-live="polite">@block.Count</span>
                            <button type="button" class="chip-btn" aria-label="Repeat more times"
                                    disabled="@(Disabled || block.Count >= Instruction.MaxRepeat)"
                                    @onclick="() => OnCountChange.InvokeAsync((block, 1))"
                                    @onclick:stopPropagation="true">+</button>
                            <span class="times">times</span>
                        </span>
                        break;

                    case BlockKind.RepeatUntilFlag:
                        <span class="block-label">Repeat until <span aria-hidden="true">🚩</span><span class="visually-hidden">the flag</span></span>
                        break;

                    case BlockKind.If:
                        <span class="block-label if-label">
                            If
                            <button type="button" class="condition-btn"
                                    aria-label="Checking for @block.ConditionLabel. Tap to change."
                                    disabled="@Disabled"
                                    @onclick="() => OnCycleCondition.InvokeAsync(block)"
                                    @onclick:stopPropagation="true">
                                @block.ConditionLabel <span aria-hidden="true">⟳</span>
                            </button>
                        </span>
                        break;

                    default:
                        <span class="block-label">@block.Label</span>
                        break;
                }

                <button type="button" class="chip-btn remove-btn" aria-label="Remove @block.Label block"
                        disabled="@Disabled"
                        @onclick="() => OnRemove.InvokeAsync(block)"
                        @onclick:stopPropagation="true">✕</button>
            </div>

            @if (block.IsContainer)
            {
                @Well(block.Body, block.Kind == BlockKind.If ? "Blocks here run when the answer is yes" : "Blocks here repeat")
            }

            @if (block.Kind == BlockKind.If)
            {
                <p class="else-label">Otherwise</p>
                @Well(block.ElseBody, "Blocks here run when the answer is no")
            }
        </li>
    }
</ol>

@code {
    [Parameter, EditorRequired] public List<Instruction> Items { get; set; } = default!;
    [Parameter] public List<Instruction>? Target { get; set; }
    [Parameter] public Guid? ActiveId { get; set; }
    [Parameter] public Guid? FailedId { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<Instruction> OnRemove { get; set; }
    [Parameter] public EventCallback<List<Instruction>> OnSelectTarget { get; set; }
    [Parameter] public EventCallback<(Instruction Block, int Delta)> OnCountChange { get; set; }
    [Parameter] public EventCallback<Instruction> OnCycleCondition { get; set; }

    /// <summary>A drop area inside a container block. Tapping it makes new blocks go here.</summary>
    private RenderFragment Well(List<Instruction> list, string emptyHint)
    {
        var isTarget = ReferenceEquals(Target, list);
        return @<div class="well @(isTarget ? "is-target" : "")"
                     role="button" tabindex="0"
                     aria-pressed="@(isTarget ? "true" : "false")"
                     aria-label="Add new blocks here"
                     @onclick="() => OnSelectTarget.InvokeAsync(list)"
                     @onclick:stopPropagation="true"
                     @onkeydown="e => SelectOnKey(e, list)">
            @if (list.Count == 0)
            {
                <p class="well-empty">@(isTarget ? "New blocks land here" : emptyHint)</p>
            }
            else
            {
                <BlockList Items="list" Target="Target" ActiveId="ActiveId" FailedId="FailedId" Disabled="Disabled"
                           OnRemove="OnRemove" OnSelectTarget="OnSelectTarget"
                           OnCountChange="OnCountChange" OnCycleCondition="OnCycleCondition" />
            }
        </div>;
    }

    private static string KindClass(BlockKind kind) => kind switch
    {
        BlockKind.MoveForward                            => "move",
        BlockKind.Repeat or BlockKind.RepeatUntilFlag    => "loop",
        BlockKind.If                                     => "if",
        _                                                => "turn"
    };

    private async Task SelectOnKey(KeyboardEventArgs e, List<Instruction> list)
    {
        if (e.Key is "Enter" or " ")
            await OnSelectTarget.InvokeAsync(list);
    }
}
